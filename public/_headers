/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=(), fullscreen=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: index, follow

# CSP only on HTML so static assets stay flexible. Allows inline styles
# (Tailwind extracts most), Google Fonts, PayMongo iframes, Google sign-in,
# Cloudflare Turnstile + Web Analytics, and Sentry browser-SDK ingest
# endpoints. `frame-ancestors 'none'` is the CSP-3 equivalent of
# X-Frame-Options: DENY (kept in `/*` above for legacy browsers).
#
# Observability allowlist:
#   script-src   static.cloudflareinsights.com  Web Analytics beacon JS
#   connect-src  cloudflareinsights.com         Web Analytics beacon POSTs
#   connect-src  *.ingest.sentry.io             Sentry event POSTs (EU/global)
#   connect-src  *.ingest.us.sentry.io          Sentry event POSTs (US org)
# When VITE_CF_ANALYTICS_TOKEN / VITE_SENTRY_DSN are unset, neither
# integration loads, but the allowlist is harmless either way.
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://apis.google.com https://www.gstatic.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.paymongo.com https://oauth2.googleapis.com https://accounts.google.com https://challenges.cloudflare.com https://cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://accounts.google.com https://content.google.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin

# Service worker should be revalidated on every load and scoped to the
# whole origin so navigation requests can be intercepted.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8
