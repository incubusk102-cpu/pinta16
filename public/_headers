/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=(), fullscreen=(self), usb=(), bluetooth=(), serial=(), hid=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: index, follow
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com https://www.gstatic.com https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.paymongo.com https://oauth2.googleapis.com https://accounts.google.com https://challenges.cloudflare.com https://cloudflareinsights.com https://api.maptiler.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; worker-src 'self' blob:; frame-src https://accounts.google.com https://content.google.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# CSP rationale (kept on the global `/*` rule above so it applies to every
# SPA route — `/`, `/product/<id>`, `/admin`, etc. The previous `/*.html`
# selector only matched explicit .html requests, which Cloudflare Pages
# never produces for the SPA: every navigation hits `/foo` and is rewritten
# to `index.html` server-side, so the CSP header was effectively never sent
# to browsers.):
#
# `script-src` no longer allows `'unsafe-inline'` — splash logic was
# extracted to `/splash.js` (see #231) and the only remaining inline
# `<script>` tags are `<script type="application/ld+json">` data
# blocks (Organization/WebSite in `index.html`, BreadcrumbList
# rendered by route components). All major browsers treat
# `application/ld+json` as data, not script, so they're not subject
# to script-src enforcement.
#
# `style-src` still allows `'unsafe-inline'` because Radix UI and
# Tailwind 4 emit `style="..."` attributes for positioning and CSS
# custom properties. Removing it would require migrating every
# component that uses inline styles, which is out of scope here.
#
# `worker-src 'self' blob:` is required by maplibre-gl, which spawns
# its tile-decoder worker from a blob URL. Without this directive the
# hybrid address picker (PR #163) silently fails to render the map.
#
# Allowlists:
#   script-src   accounts.google.com, apis.google.com, www.gstatic.com  Google Sign-In (GIS)
#                challenges.cloudflare.com                              Turnstile widget
#                static.cloudflareinsights.com                          Cloudflare Web Analytics beacon JS
#   style-src    fonts.googleapis.com                                   Google Fonts CSS
#   font-src     fonts.gstatic.com, data:                               Google Fonts woff2 + base64 fallbacks
#   connect-src  api.paymongo.com                                       PayMongo Sources API
#                oauth2.googleapis.com, accounts.google.com             Google Sign-In token exchange
#                challenges.cloudflare.com                              Turnstile siteverify
#                cloudflareinsights.com                                 Cloudflare Web Analytics beacon POSTs
#                api.maptiler.com                                       MapTiler vector tiles + geocoding (PR #163)
#                *.ingest.sentry.io, *.ingest.us.sentry.io              Sentry browser-SDK ingest endpoints
#   frame-src    accounts.google.com, content.google.com                Google Sign-In iframe
#                challenges.cloudflare.com                              Turnstile iframe
#
# When VITE_CF_ANALYTICS_TOKEN / VITE_SENTRY_DSN / MAPTILER_API_KEY are
# unset, the corresponding integration silently no-ops, so the allowlist
# entries are harmless either way.
#
# `frame-ancestors 'none'` is the CSP-3 equivalent of X-Frame-Options:
# DENY (kept above for legacy browsers).

# Vite emits content-hashed filenames for every JS / CSS bundle (e.g.
# `index-Di3Ho0Ic.js`). Hashed filenames are content-addressed: the
# bytes for a given URL never change, so the browser can keep them
# forever. Without this header Cloudflare's default
# `Cache-Control: public, max-age=14400, must-revalidate` makes every
# repeat visit revalidate the whole hashed bundle list (304s, but
# still a round-trip). `immutable` skips revalidation entirely. If a
# bundle's contents change, the hash changes and a new URL is fetched.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Resource-Policy: same-origin
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  X-Robots-Tag: noindex, nofollow

# Service worker should be revalidated on every load and scoped to the
# whole origin so navigation requests can be intercepted.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

# RFC 9116 — security.txt is intentionally cacheable. Researchers and
# automated scanners read this to find a vulnerability-reporting contact;
# they don't expect freshness, and we want CDN caching for cheap reads.
/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
